APP_NAME=Rewatch
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/backend/database/database.sqlite
LEGACY_DATABASE=/var/www/legacy/movietracker.db

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_COOKIE=rewatch_port_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

FRONTEND_URL=http://localhost:3002
SANCTUM_STATEFUL_DOMAINS=localhost:3002,127.0.0.1:3002,localhost:8081,127.0.0.1:8081
TMDB_API_KEY=
LOCAL_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=info
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@rewatch.local
MAIL_FROM_NAME=Rewatch
